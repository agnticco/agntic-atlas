# Dependencies
node_modules/
.npm/
.pnp.*

# Environment & secrets
.env
.env.*
!.env.example
!deploy/.env.production.example
*.pem
*.key

# Build output
dist/
build/
.cache/

# Logs
logs/
*.log
npm-debug.log*

# Runtime data (root-level runtime dir only; NOT src/memory/ source)
/memory/
*.sqlite

# Local model weights (GGUF) — large binaries, fetched out-of-band (see docs)
models/
*.gguf
*.sqlite3
*.db

# OS / editor
.DS_Store
Thumbs.db
.idea/
*.swp

# Local editor/assistant tooling. Not part of the product and not published —
# it is configuration for whoever happens to be working on Atlas, and it means
# nothing to anyone cloning the repo.
.claude/
.cursor/
.aider*

# Local MCP server config — NOT product config.
# .mcp.json enables MCP servers (e.g. chrome-devtools, which grants automated
# browser control). Kept local and opt-in rather than committed, so cloning the
# repo never silently grants those capabilities to anyone who did not choose them.
.mcp.json

# Design/brand asset drops — large binaries, not source.
*.zip

# Scratch output from QA runs, live-verification screenshots and one-off
# investigations. Named individually until 2026-08-14, by which point 137MB of it
# was sitting in the working tree and one 0-byte file created by a mistyped shell
# command had been COMMITTED. Globbed instead, so the next one is ignored by
# default rather than after someone notices.
tmp-*/
.qa-shots/
.preview-shots/
*-shots/

