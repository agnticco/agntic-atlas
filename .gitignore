# Dependencies
node_modules/
.npm/
.pnp.*

# Environment & secrets
.env
.env.*
!.env.example
!deploy/.env.production.example
*.pem
*.key

# Build output
dist/
build/
.cache/

# Logs
logs/
*.log
npm-debug.log*

# Runtime data (root-level runtime dir only; NOT src/memory/ source)
/memory/
*.sqlite

# Local model weights (GGUF) — large binaries, fetched out-of-band (see docs)
models/
*.gguf
*.sqlite3
*.db

# OS / editor
.DS_Store
Thumbs.db
.idea/
*.swp

# Local Claude session artifacts (keep .claude/ config, ignore local state)
.claude/local/
.claude/*.local.*

# Local agent tooling — NOT product config.
# .mcp.json enables MCP servers (e.g. chrome-devtools, which grants an agent
# browser control). Kept local and opt-in rather than committed, so cloning the
# repo never silently grants an agent capabilities the operator didn't choose.
.mcp.json

# Design/brand asset drops — large binaries, not source.
*.zip
tmp-uitest/
tmp-g-verify/

# Agent-org positions are installed to ~/.claude/agents (outside any repo).
# A copy here would shadow the real one and can be deleted by a branch operation.
.claude/agents/qa-*.md
.claude/agents/coding-*.md
