# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Strong random string (≥32 chars). If unset, a random secret is auto-generated
# and written to memory/.jwt-secret — back that file up, or set this in prod.
JWT_SECRET=

# ── OAuth token encryption ────────────────────────────────────────────────────
# 32-byte key, base64 or hex encoded. Generate: openssl rand -base64 32
# If unset, a random key is auto-generated and written to memory/.oauth-key.
OAUTH_TOKEN_KEY=

# Base URL this server is reachable at — used to build OAuth redirect URIs
# AND password-reset links, so set it to the public hostname in production.
OAUTH_REDIRECT_BASE=http://localhost:3000

# ── Transactional email (password reset) ──────────────────────────────────────
# Powers the self-service "Forgot password" flow. The mailer auto-selects the
# first configured option below; if none is set, reset requests still succeed
# but the email is only logged server-side.
#
# (A) RECOMMENDED — Resend (dedicated provider, keyless-from-Google).
#   Verify your domain on Resend (add the SPF/DKIM records it gives you to your
#   DNS), create an API key, and send from an address on that domain.
# RESEND_API_KEY=re_...
# MAIL_FROM=Atlas <hello@your.co>
#
# (B) Gmail API via a Google service account (no app password). Needs a service
#   account JSON key + domain-wide delegation for scope
#   https://www.googleapis.com/auth/gmail.send. Blocked if the org enforces
#   iam.disableServiceAccountKeyCreation.
# GMAIL_SA_KEY_FILE=./memory/gmail-sa-key.json   # gitignored — keep the key local
# GMAIL_SEND_AS=hello@your.co
# MAIL_FROM=Atlas <hello@your.co>
#
# (C) Generic SMTP (SES/Postmark/Mailgun/…).
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true for port 465 (implicit TLS)
# SMTP_USER=...
# SMTP_PASS=...
# MAIL_FROM=Atlas <no-reply@your.co>
#
# Login/reset throttle (sensible defaults; override if needed):
# LOGIN_MAX_FAILS=10
# LOGIN_WINDOW_MS=900000

# ── Database paths (defaults work for local dev) ──────────────────────────────
# AUTH_DB=./memory/auth.sqlite
# OAUTH_DB=./memory/oauth.sqlite
# WORKFLOWS_DB=./memory/workflows.sqlite
# SOURCES_DB=./memory/sources.sqlite
# INTERACTIONS_DB=./memory/interactions.sqlite

# ── Slack ─────────────────────────────────────────────────────────────────────
# OAuth app credentials (from api.slack.com/apps → OAuth & Permissions)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/connectors/slack/callback

# Direct bot token — used without a full OAuth flow (dev / single-workspace)
SLACK_BOT_TOKEN=xoxb-...

# User token — required for user-scoped actions (files, DMs, etc.)
# SLACK_USER_TOKEN=xoxp-...

# Override Slack API base (e.g. for stub server in tests)
# SLACK_API_URL=https://slack.com/api

# ── Google / G-Suite ──────────────────────────────────────────────────────────
# OAuth 2.0 credentials (from console.cloud.google.com → APIs & Services → Credentials)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Redirect URI registered in Google Cloud Console.
# Must exactly match one of the authorized redirect URIs on the credential.
GOOGLE_REDIRECT_URI=http://localhost:3000/connectors/google/callback

# Space or comma-separated scope overrides. Default requests all G-Suite scopes
# (Gmail, Calendar, Drive, Sheets, Docs, Tasks) so one consent covers everything.
# GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/calendar

# Directory where Gmail poll watermarks are persisted (one file per workflow).
# GMAIL_WATERMARK_DIR=./memory/gmail

# ── LLM / Embeddings ─────────────────────────────────────────────────────────
# Cloud inference (Anthropic takes priority over OpenAI; both over local weights)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# VOYAGE_API_KEY=
# LOCAL_MODEL_PATH=./models/...
# EMBEDDING_PROVIDER=openai          # openai | voyage | local
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_MODEL_PATH=

# GPU acceleration for local models (auto | metal | cuda | false)
# LLAMA_GPU=auto

# ── RAG ───────────────────────────────────────────────────────────────────────
# VECTOR_DIR=./memory/vectors
# RAG_CHUNK_SIZE=512
# RAG_CHUNK_OVERLAP=64
# DOCLING_URL=http://localhost:5001

# ── Support tickets (in-app feedback / bug-report widget) ────────────────────
# All optional. Without them, tickets still store + triage in the admin app;
# these only add team notifications + GitHub hand-off.
# TICKETS_DB=./memory/tickets/tickets.sqlite   # store location (default shown)
# TICKETS_DIR=./memory/tickets                 # screenshot blob dir (default shown)
# SUPPORT_EMAIL=team@agntic.co                 # email each new ticket to this inbox
# SUPPORT_SLACK_CHANNEL=#atlas-feedback        # + post to this channel (needs SLACK_BOT_TOKEN)
# GITHUB_REPO=agntic/atlas                     # "owner/repo" for one-click issue filing
# GITHUB_TOKEN=github_pat_...                  # token with issues:write on GITHUB_REPO

# ── Billing (Stripe) — self-serve plan upgrades ─────────────────────────────
# Without these the app boots fine and the Upgrade modal shows plans with the
# checkout buttons hidden (usage.billingConfigured=false); only real checkout
# needs them. Create the products/prices in the Stripe dashboard, one recurring
# monthly price per sellable plan, then paste the price ids below.
# STRIPE_SECRET_KEY=sk_live_...                 # or sk_test_... in test mode
# STRIPE_WEBHOOK_SECRET=whsec_...              # from the /webhooks/stripe endpoint
# STRIPE_PRICE_SOLO=price_...                  # $20/mo
# STRIPE_PRICE_PROFESSIONAL=price_...          # $50/mo
# STRIPE_PRICE_TEAM=price_...                  # $200/mo
# STRIPE_PRICE_BUSINESS=price_...              # $600/mo
# STRIPE_AUTOMATIC_TAX=true                    # collect sales tax/VAT at checkout.
#   Turn on ONLY after Stripe Tax is enabled in the dashboard, an origin address is
#   set, and you've registered in the jurisdictions where you have nexus. Products
#   carry the SaaS tax code (txcd_10103001). Off by default.
# Purchase alerts (new subscriptions) reuse the support channel/inbox by default
# (SUPPORT_SLACK_CHANNEL / SUPPORT_EMAIL + SLACK_BOT_TOKEN). Override to route them
# elsewhere:
# BILLING_SLACK_CHANNEL=#atlas-sales
# BILLING_EMAIL=founders@agntic.co

# ── Misc ──────────────────────────────────────────────────────────────────────
# VERBOSE=true
# WATCHER_INGEST_ON_START=false
# WATCHER_DEBOUNCE_MS=500
