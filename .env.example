# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Strong random string (≥32 chars). If unset, a random secret is auto-generated
# and written to memory/.jwt-secret — back that file up, or set this in prod.
JWT_SECRET=

# ── OAuth token encryption ────────────────────────────────────────────────────
# 32-byte key, base64 or hex encoded. Generate: openssl rand -base64 32
# If unset, a random key is auto-generated and written to memory/.oauth-key.
OAUTH_TOKEN_KEY=

# Base URL this server is reachable at — used to build OAuth redirect URIs.
OAUTH_REDIRECT_BASE=http://localhost:3000

# ── Database paths (defaults work for local dev) ──────────────────────────────
# AUTH_DB=./memory/auth.sqlite
# OAUTH_DB=./memory/oauth.sqlite
# WORKFLOWS_DB=./memory/workflows.sqlite
# SOURCES_DB=./memory/sources.sqlite
# INTERACTIONS_DB=./memory/interactions.sqlite

# ── Slack ─────────────────────────────────────────────────────────────────────
# OAuth app credentials (from api.slack.com/apps → OAuth & Permissions)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/connectors/slack/callback

# Direct bot token — used without a full OAuth flow (dev / single-workspace)
SLACK_BOT_TOKEN=xoxb-...

# User token — required for user-scoped actions (files, DMs, etc.)
# SLACK_USER_TOKEN=xoxp-...

# Override Slack API base (e.g. for stub server in tests)
# SLACK_API_URL=https://slack.com/api

# ── Google / G-Suite ──────────────────────────────────────────────────────────
# OAuth 2.0 credentials (from console.cloud.google.com → APIs & Services → Credentials)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Redirect URI registered in Google Cloud Console.
# Must exactly match one of the authorized redirect URIs on the credential.
GOOGLE_REDIRECT_URI=http://localhost:3000/connectors/google/callback

# Space or comma-separated scope overrides. Default requests all G-Suite scopes
# (Gmail, Calendar, Drive, Sheets, Docs, Tasks) so one consent covers everything.
# GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/calendar

# Directory where Gmail poll watermarks are persisted (one file per workflow).
# GMAIL_WATERMARK_DIR=./memory/gmail

# ── LLM / Embeddings ─────────────────────────────────────────────────────────
# Cloud inference (Anthropic takes priority over OpenAI; both over local weights)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# VOYAGE_API_KEY=
# LOCAL_MODEL_PATH=./models/...
# EMBEDDING_PROVIDER=openai          # openai | voyage | local
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_MODEL_PATH=

# GPU acceleration for local models (auto | metal | cuda | false)
# LLAMA_GPU=auto

# ── RAG ───────────────────────────────────────────────────────────────────────
# VECTOR_DIR=./memory/vectors
# RAG_CHUNK_SIZE=512
# RAG_CHUNK_OVERLAP=64
# DOCLING_URL=http://localhost:5001

# ── Misc ──────────────────────────────────────────────────────────────────────
# VERBOSE=true
# WATCHER_INGEST_ON_START=false
# WATCHER_DEBOUNCE_MS=500
