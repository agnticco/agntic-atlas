#!/usr/bin/env bash
# Enforces Atlas's commit convention: Conventional Commits + phase/gate tags.
# Portable POSIX-ish shell — works on macOS's default bash 3.2.
# See docs/COMMIT_CONVENTION.md. Bypass in emergencies with: git commit --no-verify
set -eu

msg_file="$1"

fail() {
  echo "x commit-msg: $1" >&2
  echo "  see docs/COMMIT_CONVENTION.md (bypass: --no-verify)" >&2
  exit 1
}

# Drop comment lines and trailing whitespace.
cleaned="$(grep -vE '^[[:space:]]*#' "$msg_file" | sed -e 's/[[:space:]]*$//')"

# Header = first non-blank line.
header="$(printf '%s\n' "$cleaned" | grep -vE '^[[:space:]]*$' | head -n1)"

# Exempt automated/merge commits.
case "$header" in
  Merge\ *|Revert\ *|Reapply\ *|"fixup! "*|"squash! "*) exit 0 ;;
esac

[ -n "$header" ] || fail "empty commit message"

# 1) Header shape: type(scope)?: subject
types='feat|fix|refactor|test|chore|docs|build|ci|perf|style'
if ! printf '%s' "$header" | grep -qE "^($types)(\([a-z0-9-]+\))?!?: .+"; then
  fail "header must be '<type>(<scope>): <subject>' — type one of: $types
  got: $header"
fi

# 2) Header length <= 72.
if [ "${#header}" -gt 72 ]; then
  fail "header is ${#header} chars (max 72): $header"
fi

# 3) Subject must not end with a period.
subject="${header#*: }"
case "$subject" in
  *.) fail "subject should not end with a period: $subject" ;;
esac

# 4) Type (strip scope/colon) drives the trailer rules.
type="${header%%[(:]*}"

has_phase=no
if printf '%s\n' "$cleaned" | grep -qE '^Phase:[[:space:]]*[0-9]+[[:space:]]*$'; then
  has_phase=yes
fi

# 5) feat/fix/refactor/test must carry a valid Phase trailer.
case "$type" in
  feat|fix|refactor|test)
    [ "$has_phase" = yes ] || fail "$type commits require a 'Phase: <N>' trailer" ;;
esac

# 6) A Gate: trailer must be non-empty and accompanied by a Phase: trailer.
if printf '%s\n' "$cleaned" | grep -qE '^Gate:'; then
  printf '%s\n' "$cleaned" | grep -qE '^Gate:[[:space:]]*[^[:space:]]' \
    || fail "Gate: trailer is present but empty"
  [ "$has_phase" = yes ] || fail "a Gate: trailer requires a Phase: trailer too"
fi

# 7) NO CLAUDE CODE ATTRIBUTION. The operator's standing instruction, given twice —
# once to strip a Co-Authored-By trailer, once after a PR body carried a
# "Generated with Claude Code" line. The agent harness appends both BY DEFAULT, so
# every session is told to add them and has to remember not to. Remembering did not
# work: it drifted into 15 consecutive commits before anyone noticed, each one an
# agent reasoning "the repo does it, so it must be right" from the evidence of the
# last drift. A preference that must be re-remembered by every session is not
# enforced by anything — this is what makes being wrong about it harmless.
#
# The commits already carrying it are left alone on purpose (see
# docs/COMMIT_CONVENTION.md): they are shipped and deployed, and a force-push to
# main is the one operation that can eat a parallel session's work. So the log
# below this commit is NOT evidence that the trailer is wanted — reading it that
# way is the exact mistake this rule exists to stop.
if printf '%s\n' "$cleaned" | grep -qiE '^Co-Authored-By:.*(Claude|Anthropic|noreply@anthropic)'; then
  fail "no Claude Code attribution — remove the 'Co-Authored-By: Claude ...' trailer"
fi
# ANCHORED TO THE START OF A LINE, because the attribution is always its own line and
# a message must stay able to DESCRIBE this rule. The first version matched the phrase
# anywhere and promptly rejected the very commit adding the rule, which quoted it in
# prose — a guard nobody can write about is one people route around.
if printf '%s\n' "$cleaned" | grep -qiE '^[^A-Za-z]*Generated with \[?Claude Code'; then
  fail "no Claude Code attribution — remove the 'Generated with ...' line"
fi

exit 0
