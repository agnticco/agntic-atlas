# Atlas production env — copy to ~/atlas/.env on the VPS and fill in the values.
# `.env` is gitignored and loaded by `npm run prod`
# (node --env-file-if-exists=.env). See docs/deployment/vps-runbook.md §4.
#
# validateBootConfig() FAILS FAST if NODE_ENV=production and no LLM key is set —
# intentional (no silent fallback to the local model).

# ── Required ──────────────────────────────────────────────────────────────────
NODE_ENV=production
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
OAUTH_REDIRECT_BASE=https://atlas.agntic.co
CORS_ALLOWED_ORIGINS=https://atlas.agntic.co

# ── Knowledge / RAG embeddings ────────────────────────────────────────────────
# Backend that powers Knowledge/RAG. Cloud (voyage) is recommended for a hosted
# box: nothing to ship, no local CPU/RAM load, better retrieval quality. The
# local GGUF path from the early local-agent build still works but competes with
# the app for RAM/CPU on a small VPS.
#   voyage  — Voyage AI (Anthropic's recommended partner). Needs VOYAGE_API_KEY.
#             EMBEDDING_MODEL: voyage-3 (default) | voyage-3-lite (cheaper) | voyage-3-large
#   openai  — OpenAI text-embedding-3-small. Needs OPENAI_API_KEY.
#   local   — On-box GGUF via node-llama-cpp. Free, but needs the model file on the
#             box at EMBEDDING_MODEL_PATH and uses VPS RAM/CPU.
# NOTE: switching providers later requires RE-INDEXING existing Knowledge — vectors
# from different models are incompatible. Choose before indexing any data.
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=voy-REPLACE_ME
# EMBEDDING_MODEL=voyage-3-lite

# ── Transactional email (password reset) — Resend ────────────────────────────
# See src/utils/mailer.js. Resend is the preferred sender.
RESEND_API_KEY=re_REPLACE_ME
MAIL_FROM=Atlas by Agntic <hello@agntic.co>

# ── Connectors you enable (register redirect URLs in each provider console:
#    https://atlas.agntic.co/connectors/<name>/callback — derived from
#    OAUTH_REDIRECT_BASE). Omit a connector's block to leave it disconnected. ──
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=

# ── Optional hardening knobs (sensible defaults in code — override only to tune) ─
PORT=3000
SCHEDULER_ENABLED=true            # false on all-but-one instance if you scale out
TENANT_DAILY_USD_LIMIT=25         # per-tenant daily LLM spend cap
TENANT_MAX_CONCURRENT=6           # per-tenant in-flight cap
LLM_MAX_RETRIES=4
LLM_TIMEOUT_MS=120000
NODE_RUN_TIMEOUT_MS=180000        # per-node execution backstop
EVENT_LOG_MAX_BYTES=10485760
EVENT_LOG_KEEP=3
DB_BACKUP_KEEP=7                  # boot snapshots kept under ./memory/backups
CONVERGER_TTL_DAYS=7              # abandoned converger session sweep
SHUTDOWN_GRACE_MS=10000
